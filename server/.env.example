# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file — it's already in .gitignore.

# MongoDB Atlas connection string (see README.md, step "Set up the database")
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/portfolio?retryWrites=true&w=majority

# Any long random string — used to sign admin login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# The admin account you'll log into the /admin panel with.
# Only used once, by "npm run seed" (see README.md), to create the account.
ADMIN_EMAIL=salahddinedkaki@gmail.com
ADMIN_PASSWORD=choose_a_strong_password

# Port the API runs on locally. Render sets this automatically in production.
PORT=5000

# Comma-separated list of frontend origins allowed to call this API.
# Add your GitHub Pages URL here once you know it, e.g.:
# CLIENT_ORIGIN=http://127.0.0.1:5500,https://salahddinedkaki.github.io
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# --- Optional: email notifications when someone submits the contact form ---
# Leave these blank to skip email notifications (messages are always saved
# to the database either way, and visible in the admin panel).
# For Gmail: enable 2-Step Verification, then create an "App Password" at
# https://myaccount.google.com/apppasswords — do NOT use your normal password.
SMTP_USER=
SMTP_APP_PASSWORD=
NOTIFY_EMAIL=salahddinedkaki@gmail.com
